#Intel® Core i7-1355U Intel® Core i5-1335U Intel® Core i3-1315U (TDP 15W)
#Intel® Iris® Xe Graphics (i7/i5) Intel® UHD Graphics (i3)
#Intel® Wi-Fi 6E AX211, 2x2
#M.2 2280 PCIe Gen4x4 NVMe SSD
#Winbond w25q256jv 32MB WSON-8


CONFIG_LINUX_CONFIG=config/linux-kuldax.config
CONFIG_COREBOOT_CONFIG=config/coreboot-kuldax.config
export CONFIG_BOOT_DEV="/dev/nvme0n1p1"
export CONFIG_ROOT_DEV="/dev/nvme0n1p2"

#Modules packed into tools.cpio
CONFIG_CRYPTSETUP2=y
CONFIG_FLASHPROG=y
CONFIG_FLASHTOOLS=y
CONFIG_GPG2=y
CONFIG_KEXEC=y
CONFIG_UTIL_LINUX=y
CONFIG_LVM2=y
CONFIG_MBEDTLS=y
CONFIG_PCIUTILS=y
CONFIG_POPT=y
CONFIG_QRENCODE=y
CONFIG_TPMTOTP=y
#CONFIG_HOTPKEY=y
#GUI
CONFIG_CAIRO=y
CONFIG_FBWHIPTAIL=y
#Console based Whiptail support(Console based, no FB):
#CONFIG_SLANG=y
#CONFIG_NEWT=y

#On-demand hardware support (modules.cpio)
CONFIG_LINUX_USB=y
CONFIG_SUPPORT_USB_KEYBOARD=y
export CONFIG_USB_KEYBOARD_REQUIRED=y

# TPM1 requirements
#export CONFIG_TPM=y
# TPM2 requirements
export CONFIG_TPM2_TOOLS=y
export CONFIG_PRIMARY_KEY_TYPE=ecc
CONFIG_TPM2_TSS=y
CONFIG_OPENSSL=y
export CONFIG_TPM2_CAPTURE_PCAP=y

#Runtime configuration
#Automatically boot if HOTP is valid
export CONFIG_AUTO_BOOT_TIMEOUT=5
export CONFIG_BOOTSCRIPT=/bin/gui-init.sh
export CONFIG_BOOT_REQ_HASH=n
export CONFIG_BOOT_REQ_ROLLBACK=n
export CONFIG_BOOT_KERNEL_ADD=""
export CONFIG_BOOT_KERNEL_REMOVE=""
export CONFIG_ROOT_DIRLIST="bin boot lib sbin usr"
export CONFIG_ROOT_CHECK_AT_BOOT="n"
export CONFIG_COREBOOT=y
export CONFIG_BOARD_NAME="kuldax"
export CONFIG_FLASH_OPTIONS="flashprog --progress --programmer internal --ifd -i bios -i fd"
#Enable DEBUG output
export CONFIG_DEBUG_OUTPUT=y
export CONFIG_ENABLE_FUNCTION_TRACING_OUTPUT=y

#platform locking finalization (PR0)
# This prevents SPI from being writeable outside of Heads
CONFIG_IO386=y
#export CONFIG_FINALIZE_PLATFORM_LOCKING=y
CONFIG_COREBOOT_APPLY_HAP=y
CONFIG_COREBOOT_GPR0_DISABLE=y         # ME region stays RO even with FLMSTR unlocked without this
export CONFIG_LINUX_VERSION=6.1.8
export CONFIG_COREBOOT_VERSION=25.03

#HOTP based remote attestation for supported USB Security dongle
#With/Without TPM support
#CONFIG_HOTPKEY=y
