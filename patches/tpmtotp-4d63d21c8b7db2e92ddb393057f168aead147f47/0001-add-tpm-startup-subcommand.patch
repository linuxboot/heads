+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "tpm.h"
+#include "tpmutil.h"
+#include "tpmfunc.h"
+#include "tpm_constants.h"
+
+static void printUsage(void);
+
+int startup_main(int argc, char *argv[])
+{
+	int i;
+
+	TPM_setlog(0);
+
+	for (i=1 ; i<argc ; i++) {
+	    if (!strcmp(argv[i], "-h")) {
+		printUsage();
+		return 0;
+	    }
+	    else if (!strcmp(argv[i], "-v")) {
+		TPM_setlog(1);
+	    }
+	    else {
+		printf("\n%s is not a valid option\n", argv[i]);
+		printUsage();
+		return -1;
+	    }
+	}
+
+	uint32_t ret = TPM_Startup(TPM_ST_CLEAR);
+	if (0 != ret) {
+	    printf("Error %s from TPM_Startup\n",
+		   TPM_GetErrMsg(ret));
+	    return ret;
+	}
+	printf("TPM_Startup(ST_CLEAR) ok\n");
+	return 0;
+}
+
+static void printUsage(void)
+{
+    printf("\n");
+    printf("startup\n");
+    printf("\n");
+    printf("Runs TPM_Startup(ST_CLEAR) - restart the TPM after a platform\n");
+    printf("reset signal without touching ownership.  PCRs are cleared.\n");
+    printf("\n");
+    return;
+}
+
+#include "tpm_command.h"
+tpm_command_register("startup", startup_main, printUsage)
