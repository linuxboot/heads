-+		    {
-+		      /* Transform to plus if immediate can fit addi45.  */
-+		      pat = gen_rtx_PLUS (SImode, src, GEN_INT (val));
-+		      done = TRUE;
-+		      if (dump_file)
-+			fprintf (dump_file,
-+				 "Rematerialize %08x with const %08x by | %08x\n",
