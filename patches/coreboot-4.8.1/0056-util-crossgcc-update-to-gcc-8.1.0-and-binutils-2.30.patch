-+/* Search the register records.  */
-+static bool
-+try_rematerialize (rtx_insn *insn, unsigned int uint_r,
-+		   auto_vec<reg_avail_info_t, 32> *reg_avail_infos)
-+{
-+  unsigned int i, uint_i, cl_i, cl_r, ct_i, ct_r;
