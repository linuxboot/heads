--#ifdef __NDS32_ISA_V3M__
--	push25	$r10, 8
--#else
--	smw.adm	$r6, [$sp], $r10, 2
--	addi	$sp, $sp, -8
--#endif
--	! end of prologue
--	!------------------------------------------
--	! 	__moddi3 (DWtype u, DWtype v)
--	!		{
--	!			word_type c = 0;
--	!			DWunion uu = {.ll = u};
--	!			DWunion vv = {.ll = v};
--	!			DWtype w;
--	!		if (uu.s.high < 0)
--	!  		  c = ~c,
--	!		  uu.ll = -uu.ll;
--	!---------------------------------------------
--	move	$r8, V1L
--	move	$r9, V1H
--	move	$r6, V2L
--	move	$r7, V2H
--	movi	$r10, 0        ! r10 = c = 0
--	bgez	V1H, .L80      ! if u > 0 , go L80
--	bal	__negdi2
--	move	$r8, V1L
--	move	$r9, V1H
--	movi	$r10, -1       ! r10 = c = ~c
--	!------------------------------------------------
