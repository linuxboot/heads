-+
-+  for (int regno = GP_REG_FIRST; regno <= GP_REG_LAST-1; regno++)
-+    if (BITSET_P (cfun->machine->frame.mask, regno - GP_REG_FIRST))
-+      {
-+	/* The save order is ra, s0, s1, s2 to s11.  */
-+	if (regno == RETURN_ADDR_REGNUM)
