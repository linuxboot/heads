-+/* Perform machine-dependent processing.  */
-+static void
-+nds32_machine_dependent_reorg (void)
-+{
-+  /* We are freeing block_for_insn in the toplev to keep compatibility
-+     with old MDEP_REORGS that are not CFG based.  Recompute it
-+     now.  */
