-+/* Try replacing every occurrence of OLD_REGNO in INSN with NEW_REGNO.  */
-+
-+static void
-+nds32_replace_all_operands (rtx dst_reg, rtx src_reg,
-+			    unsigned int old_regno, unsigned int new_regno,
-+			    rtx_insn *insn)
-+{
