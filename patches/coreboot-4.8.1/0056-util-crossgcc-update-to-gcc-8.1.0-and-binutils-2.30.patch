-+/* Clean the reg_avail_info value.  */
-+static void
-+clean_reg_avail_info (rtx dest, const_rtx setter ATTRIBUTE_UNUSED,
-+		      void *data)
-+{
-+  unsigned int i;
-+  auto_vec<reg_avail_info_t, 32> *reg_avail_infos =
-+    (auto_vec<reg_avail_info_t, 32> *) data;
