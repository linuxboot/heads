--	lwi	$r1, [$sp+(4)]    ! le: sp + 4 is low, be: sp + 4 is high
--	beqz	$r10, .L82
--	bal	__negdi2
--.L82:
--	! epilogue
--#ifdef __NDS32_ISA_V3M__
--	pop25	$r10, 8
--#else
--	addi	$sp, $sp, 8
--	lmw.bim	$r6, [$sp], $r10, 2
