--	!----------------------------------------------
--.L80:
--	bgez	$r7, .L81     !  if v > 0 , go L81
--	move	V1L, $r6
--	move	V1H, $r7
--	bal	__negdi2
--	move	$r6, V1L
--	move	$r7, V1H
--	!------------------------------------------
--	!		(void) __udivmoddi4 (uu.ll, vv.ll, &w);
--	!		if (c)
--	!		  w = -w;
--	!		return w;
--	!-----------------------------------------
--.L81:
--	move	V2L, $r6
--	move	V2H, $r7
--	move	V1L, $r8
--	move	V1H, $r9
--	addi	$r4, $sp, 0
