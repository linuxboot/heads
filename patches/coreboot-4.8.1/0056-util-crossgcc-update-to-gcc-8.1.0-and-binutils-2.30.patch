-+
-+;; ALU, MOVD44, MUL, MAC, DIV_Rs, LD_bi, ADDR_OUT -> ADDR_IN_MOP(1)
-+(define_bypass 2
-+  "nds_e8_alu,
-+   nds_e8_mul_fast, nds_e8_mul_slow,\
-+   nds_e8_mac_fast, nds_e8_mac_slow,\
