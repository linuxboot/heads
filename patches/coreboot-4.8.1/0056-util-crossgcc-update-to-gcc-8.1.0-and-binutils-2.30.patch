--	.text
--	.align	2
--	.globl	__moddi3
--	.type	__moddi3, @function
--__moddi3:
--	! =====================================================================
--	! stack allocation:
--	! sp+32 +-----------------------+
--	!       | $lp                   |
--	! sp+28 +-----------------------+
