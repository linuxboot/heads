--	subri	$r4, $r0, 0			! $r4  <- -a
--	cmovn	$r0, $r4, $r5			! $r0  <- |a|
--	! ---------------------------------------------------------------------
--	! if (b < 0)
--#ifndef __NDS32_PERF_EXT__
