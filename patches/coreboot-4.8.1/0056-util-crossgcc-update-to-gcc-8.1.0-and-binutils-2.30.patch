-+/* Extract the rtx representing non-accumulation operands of a MAC insn.  */
-+rtx
-+extract_mac_non_acc_rtx (rtx_insn *insn)
-+{
-+  rtx exp = SET_SRC (PATTERN (insn));
-+
-+  switch (get_attr_type (insn))
-+    {
-+    case TYPE_MAC:
-+    case TYPE_DMAC:
-+      if (REG_P (XEXP (exp, 0)))
-+	return XEXP (exp, 1);
-+      else
-+	return XEXP (exp, 0);
