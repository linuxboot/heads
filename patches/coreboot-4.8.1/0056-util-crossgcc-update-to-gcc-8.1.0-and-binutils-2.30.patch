+-static void
+-nds32_elf_insert_irel_entry (struct elf_nds32_irel_entry **irel_list,
+-			     struct elf_nds32_irel_entry *irel_ptr)
+-{
+-  if (*irel_list == NULL)
+-    {
+-      *irel_list = irel_ptr;
+-      irel_ptr->next = NULL;
