-+  /* Create assembly code pattern.  */
-+  snprintf (pattern, sizeof (pattern), "pop25\t%%0, %%1");
-+  /* We use output_asm_insn() to output assembly code by ourself.  */
-+  output_asm_insn (pattern, operands);
-+  return "";
