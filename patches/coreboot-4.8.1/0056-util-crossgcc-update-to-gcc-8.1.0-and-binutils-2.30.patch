--	move	$r9, V1H
--	move	$r6, V2L
--	move	$r7, V2H
--	movi	$r10, 0
--	bgez	V1H, .L80
--	bal	__negdi2
--	move	$r8, V1L
--	move	$r9, V1H
--	movi	$r10, -1
--.L80:
--	bgez	$r7, .L81
--	move	V1L, $r6
--	move	V1H, $r7
--	bal	__negdi2
--	move	$r6, V1L
--	move	$r7, V1H
--	nor	$r10, $r10, $r10
--.L81:
--	move	V2L, $r6
--	move	V2H, $r7
--	move	V1L, $r8
--	move	V1H, $r9
--	movi	$r4, 0
--	bal	__udivmoddi4
--	beqz	$r10, .L82
--	bal	__negdi2
--.L82:
--	! epilogue
--#ifdef __NDS32_ISA_V3M__
--	pop25	$r10, 0
--#else
--	lmw.bim	$r6, [$sp], $r10, 2
--	ret
--#endif
