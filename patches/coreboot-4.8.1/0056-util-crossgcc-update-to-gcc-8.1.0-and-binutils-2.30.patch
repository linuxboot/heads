-+/* A safe wrapper to the function reg_overlap_mentioned_p ().  */
-+bool
-+reg_overlap_p (rtx x, rtx in)
-+{
-+  if (x == NULL_RTX || in == NULL_RTX)
-+    return false;
-+
-+  return static_cast <bool> (reg_overlap_mentioned_p (x, in));
