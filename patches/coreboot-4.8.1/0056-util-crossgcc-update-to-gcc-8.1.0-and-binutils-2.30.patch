-+	  note_stores (PATTERN (insn), clean_reg_avail_info, &reg_avail_infos);
-+	  reg_avail_info.insn = insn;
-+	  reg_avail_info.uint = XUINT (cst, 0);
-+	  reg_avail_info.regno = REGNO (dest);
