-+  cl_r = __builtin_clz (uint_r);
-+  ct_r = __builtin_ctz (uint_r);
-+  for (i = 0; i < reg_avail_infos->length (); ++i)
-+    {
-+      if ((*reg_avail_infos)[i].uint != uint_r)
