-+
-+/* Return true if the instruction is addi format.  */
-+static bool
-+addsi3_format_p (rtx insn)
-+{
-+  if (GET_CODE (XEXP (PATTERN (insn), 1)) == PLUS
-+      && GET_CODE (XEXP (XEXP (PATTERN (insn), 1), 1)) == CONST_INT)
