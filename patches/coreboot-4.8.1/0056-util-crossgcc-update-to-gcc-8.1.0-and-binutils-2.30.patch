-+
-+      if (nds32_use_bim_p (&first_set, &second_set))
-+	{
-+	  if (dump_file)
-+	    fprintf (dump_file, "Generate BIM form.\n");
-+
-+	  nds32_emit_multiple_insn (&first_set, base_reg, place, true);
