-+		       gimple_uid (stmt));
-+	      print_gimple_stmt (dump_file, stmt, 0, TDF_SLIM|TDF_RAW);
-+	    }
-+	  nds32_do_sign_conversion (stmt);
-+	  converse_number++;
-+	}
-+    }
