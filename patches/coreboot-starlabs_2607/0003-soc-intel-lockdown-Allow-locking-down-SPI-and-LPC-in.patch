diff --git a/src/soc/intel/common/feature/lockdown/lockdown.c b/src/soc/intel/common/feature/lockdown/lockdown.c
index 0d06a84899..6921c6f2fa 100644
--- a/src/soc/intel/common/feature/lockdown/lockdown.c
+++ b/src/soc/intel/common/feature/lockdown/lockdown.c
@@ -28,11 +28,13 @@ static void pmc_lockdown_config(int chipset_lockdown)
 		setbits32(pmcbase + GEN_PMCON_B, SMI_LOCK);
 
 	/*
-	 * When FSP PostPciEnumeration notify is enabled, FSP owns the PMC
-	 * BIOS-reset/PCI-enumeration handoff. Sending the native IPC as well
-	 * has caused PMC IPC timeouts on validated StarLabs Lite ADL firmware.
+	 * FSP normally owns the PMC BIOS-reset/PCI-enumeration handoff when
+	 * PostPciEnumeration notify is enabled. Deferred SPI lockdown cannot
+	 * call that phase because FSP locks the SPI controller, so use the
+	 * native handoff instead.
 	 */
