diff --git a/src/cpu/x86/smi_trigger.c b/src/cpu/x86/smi_trigger.c
index d164f65965..5b4ba97a03 100644
--- a/src/cpu/x86/smi_trigger.c
+++ b/src/cpu/x86/smi_trigger.c
@@ -40,8 +40,19 @@ enum cb_err apm_control(u8 cmd)
 
 	apmc_log(__func__, cmd);
 
+	if (CONFIG(SOC_INTEL_COMMON_SPI_LOCKDOWN_SMM) && cmd == APM_CNT_FINALIZE)
+		outb(0xff, APM_STS);
+
 	/* Now raise the SMI. */
 	call_smm(cmd, 0, NULL);
+	if (CONFIG(SOC_INTEL_COMMON_SPI_LOCKDOWN_SMM) && cmd == APM_CNT_FINALIZE) {
+		u8 status = inb(APM_STS);
+
+		if (status) {
+			printk(BIOS_ERR, "SMM finalization failed: %u\n", status);
+			return CB_ERR;
+		}
+	}
 
 	printk(BIOS_DEBUG, "APMC done.\n");
 	return CB_SUCCESS;
