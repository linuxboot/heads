 	printk(BIOS_DEBUG, "Enabled and locked SMM code check\n");
 }
 
-static void finalize(void)
+static int finalize(void)
 {
 	static int finalize_done;
 
 	if (finalize_done) {
 		printk(BIOS_DEBUG, "SMM already finalized.\n");
-		return;
+		return 0;
+	}
+
+	if (CONFIG(SOC_INTEL_COMMON_SPI_LOCKDOWN_SMM)) {
+		int status;
+
+		/* SPI lock down configuration */
+		status = fast_spi_lockdown_bios(CHIPSET_LOCKDOWN_COREBOOT);
+		if (status < 0)
+			return status;
+
+		/* LPC/eSPI lock down configuration */
+		lpc_lockdown_config(CHIPSET_LOCKDOWN_COREBOOT);
 	}
-	finalize_done = 1;
 
 	if (CONFIG(SPI_FLASH_SMM))
 		/* Re-init SPI driver to handle locked BAR */
@@ -419,6 +432,8 @@ static void finalize(void)
 	smihandler_soc_at_finalize();
 
 	enable_smm_code_access_check();
+	finalize_done = 1;
+	return 0;
 }
 
 void smihandler_southbridge_apmc(
@@ -442,10 +457,13 @@ void smihandler_southbridge_apmc(
 		if (CONFIG(SMMSTORE))
 			southbridge_smi_store(save_state_ops);
 		break;
-	case APM_CNT_FINALIZE:
-		finalize();
+	case APM_CNT_FINALIZE: {
+		int status = finalize();
+
+		outb(status < 0 ? -status : 0, APM_STS);
 		break;
 	}
+	}
 
 	if (opal_s3_smi_apmc(reg8))
 		return;
