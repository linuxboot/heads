 #include <security/tcg/opal_s3_smm.h>
@@ -397,6 +399,19 @@ static void finalize(void)
 	}
 	finalize_done = 1;
 
+	if (CONFIG(SOC_INTEL_COMMON_SPI_LPC_LOCKDOWN_SMM)) {
+		/*
+		 * Always use CHIPSET_LOCKDOWN_COREBOOT here (not
+		 * get_lockdown_config()): this path defers the BIOS SPI/LPC
+		 * locks so the payload can program PR0 first, regardless of
+		 * whether FSP locked other IPs.
+		 */
+		fast_spi_pr_dlock();
+		fast_spi_lock_bar();
+		fast_spi_lockdown_bios(CHIPSET_LOCKDOWN_COREBOOT);
+		lpc_lockdown_config(CHIPSET_LOCKDOWN_COREBOOT);
+	}
+
 	enable_smm_code_access_check();
 
 	if (CONFIG(SPI_FLASH_SMM))
