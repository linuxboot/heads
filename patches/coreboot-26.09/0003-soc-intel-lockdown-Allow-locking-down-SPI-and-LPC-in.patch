+		fast_spi_lock_bar();
 
 	/* Set Vendor Component Lock (VCL) */
 	fast_spi_vscc0_lock();
 
-	fast_spi_lockdown_bios(chipset_lockdown);
+	if (!CONFIG(SOC_INTEL_COMMON_SPI_LPC_LOCKDOWN_SMM))
+		fast_spi_lockdown_bios(chipset_lockdown);
 }
 
