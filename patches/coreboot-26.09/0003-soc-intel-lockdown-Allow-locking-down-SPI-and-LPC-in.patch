diff --git a/src/soc/intel/common/pch/lockdown/Kconfig b/src/soc/intel/common/pch/lockdown/Kconfig
index 38f60d20..0fca399f 100644
--- a/src/soc/intel/common/pch/lockdown/Kconfig
+++ b/src/soc/intel/common/pch/lockdown/Kconfig
@@ -7,3 +7,20 @@ config SOC_INTEL_COMMON_PCH_LOCKDOWN
 	  This option allows to have chipset lockdown for DMI, FAST_SPI and
 	  soc_lockdown_config() to implement any additional lockdown as PMC,
 	  LPC for supported PCH.
+
+config SOC_INTEL_COMMON_SPI_LPC_LOCKDOWN_SMM
+	bool "Lock down SPI and LPC controllers in SMM"
+	default n
+	depends on HAVE_SMI_HANDLER
+	select SPI_FLASH_SMM
+	help
+	  Skip locking the FAST_SPI and LPC controllers in ramstage. The
+	  payload or OS must lock them later by issuing APM_CNT_FINALIZE SMI,
+	  which also performs the deferred SPI/LPC lockdown in SMM.
+
+	  When this option is selected, coreboot does not issue APM_CNT_FINALIZE
+	  on the normal boot path (it still does on S3 resume, where the payload
+	  does not run). Used by Heads to set and lock PR0 flash protection
+	  before handing off to the OS.
+
+	  If unsure, say N.
