diff --git a/src/soc/intel/common/block/include/intelblocks/apm_finalize.h b/src/soc/intel/common/block/include/intelblocks/apm_finalize.h
new file mode 100644
index 00000000..3b7f2b31
--- /dev/null
+++ b/src/soc/intel/common/block/include/intelblocks/apm_finalize.h
@@ -0,0 +1,19 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#ifndef SOC_INTEL_COMMON_BLOCK_APM_FINALIZE_H
+#define SOC_INTEL_COMMON_BLOCK_APM_FINALIZE_H
+
+#include <acpi/acpi.h>
+#include <cpu/x86/smm.h>
+
+/*
+ * Issue APM_CNT_FINALIZE unless SPI/LPC lockdown was deferred to the payload.
+ * On S3 resume the payload does not run, so always finalize in that case.
+ */
+static inline void intel_apm_control_finalize(void)
+{
+	if (!CONFIG(SOC_INTEL_COMMON_SPI_LPC_LOCKDOWN_SMM) || acpi_is_wakeup_s3())
+		apm_control(APM_CNT_FINALIZE);
+}
+
+#endif /* SOC_INTEL_COMMON_BLOCK_APM_FINALIZE_H */
