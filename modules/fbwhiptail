modules-$(CONFIG_FBWHIPTAIL) += fbwhiptail


# -ffunction-sections -fdata-sections and -Wl,--gc-sections -Wl,--no-eh-frame-hdr
# discard unused functions and data; each function is in its own section so the
# linker can drop what the initrd never calls, shrinking the binary.


# -fno-asynchronous-unwind-tables -fno-unwind-tables: drop .eh_frame and unwind
# tables; the initrd is single-purpose and never needs stack unwinding, saving
# meaningful bytes in the initrd payload.

fbwhiptail_depends := cairo $(musl_dep)

fbwhiptail_version := 1.3
fbwhiptail_dir := fbwhiptail-$(fbwhiptail_version)
fbwhiptail_tar := fbwhiptail-$(fbwhiptail_version).tar.gz
fbwhiptail_url := https://source.puri.sm/firmware/fbwhiptail/-/archive/$(fbwhiptail_version)/fbwhiptail-$(fbwhiptail_version).tar.gz
fbwhiptail_hash := 2eb8fadfd3e2d574de52327bbc80ed6313739a3db9f4d87840c534352c66df5a

fbwhiptail_target := \
	$(MAKE_JOBS) \
    CFLAGS="-g0 -Os -ffunction-sections -fdata-sections -fno-asynchronous-unwind-tables -fno-unwind-tables" \
    LDFLAGS="-s -Wl,--gc-sections -Wl,--no-eh-frame-hdr" \
	$(CROSS_TOOLS) \
	fbwhiptail

fbwhiptail_output := \
	fbwhiptail whiptail
