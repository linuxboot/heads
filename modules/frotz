modules-$(CONFIG_FROTZ) += frotz

frotz_version := 2.44
frotz_dir := frotz-$(frotz_version)
frotz_tar := frotz-$(frotz_version).tar.gz
frotz_url := https://github.com/DavidGriffith/frotz/archive/$(frotz_version).tar.gz
frotz_hash := dbb5eb3bc95275dcb984c4bdbaea58bc1f1b085b20092ce6e86d9f0bf3ba858f


# -ffunction-sections -fdata-sections and -Wl,--gc-sections -Wl,--no-eh-frame-hdr
# discard unused functions and data; each function is in its own section so the
# linker can drop what the initrd never calls, shrinking the binary.


# -fno-asynchronous-unwind-tables -fno-unwind-tables: drop .eh_frame and unwind
# tables; the initrd is single-purpose and never needs stack unwinding, saving
# meaningful bytes in the initrd payload.

frotz_configure := touch .config

frotz_target := \
	$(MAKE_JOBS) \
	$(CROSS_TOOLS) \
	CFLAGS="-Os -ffunction-sections -fdata-sections -fno-asynchronous-unwind-tables -fno-unwind-tables" \
	LDFLAGS="-Wl,--gc-sections -Wl,--no-eh-frame-hdr" \
	dumb && \
	mv $(build)/$(frotz_dir)/dfrotz $(build)/$(frotz_dir)/frotz

frotz_output := frotz

frotz_depends := $(musl_dep)
