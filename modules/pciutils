modules-$(CONFIG_PCIUTILS) += pciutils


# -ffunction-sections -fdata-sections and -Wl,--gc-sections -Wl,--no-eh-frame-hdr
# discard unused functions and data; each function is in its own section so the
# linker can drop what the initrd never calls, shrinking the binary.


# -fno-asynchronous-unwind-tables -fno-unwind-tables: drop .eh_frame and unwind
# tables; the initrd is single-purpose and never needs stack unwinding, saving
# meaningful bytes in the initrd payload.

pciutils_depends := $(musl_dep)

#pciutils_version := git
#pciutils_repo := https://github.com/osresearch/pciutils

pciutils_version := 3.5.4
pciutils_dir := pciutils-$(pciutils_version)
pciutils_tar := pciutils-$(pciutils_version).tar.xz
pciutils_url := https://www.kernel.org/pub/software/utils/pciutils/$(pciutils_tar)
pciutils_hash := 64293c6ab9318c40ef262b76d87bd9097531759752bac556e50979b1e63cfe66

# IDSDIR must be set to a constant during the build,
# but not during the install to make the libpci.so.3
# reproducible.  Otherwise the build path will be embedded
# in the library and executables.

pciutils_target := \
	$(MAKE_JOBS) \
	$(CROSS_TOOLS) \
	OPT="-Os -ffunction-sections -fdata-sections -fno-asynchronous-unwind-tables -fno-unwind-tables" \
	LDFLAGS="-Wl,--gc-sections -Wl,--no-eh-frame-hdr" \
	HOST=$(MUSL_ARCH)-linux-musl \
	ZLIB=no \
	HWDB=no \
	LIBKMOD=no \
	SHARED=yes \
	IDSDIR="/" \
	PREFIX="/" \
	&& \
	$(MAKE) \
	-C $(build)/$(pciutils_dir) \
	$(CROSS_TOOLS) \
	OPT="-Os -ffunction-sections -fdata-sections -fno-asynchronous-unwind-tables -fno-unwind-tables" \
	LDFLAGS="-Wl,--gc-sections -Wl,--no-eh-frame-hdr" \
	ZLIB=no \
	HWDB=no \
	LIBKMOD=no \
	SHARED=yes \
	PREFIX="/" \
	DESTDIR="$(INSTALL)" \
	install \
	install-lib \

pciutils_output := \
	lspci \

pciutils_libraries := \
	lib/libpci.so.3.5.4 \
	$(INSTALL)/lib/libpci.so.3\

pciutils_configure := 
